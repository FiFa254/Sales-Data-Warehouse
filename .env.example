# GEMINI_API_KEY: optional. Enables the Gemini AI guide in the chat panel.
# Leave it empty to use the built-in offline answers.
GEMINI_API_KEY=""

# MSSQL_CONNECTION_STRING: SQL Server database for the source tables (schema oltp),
# the star schema (dim_*, fact_sales) and the ETL log. Default: local SQL Server with
# your Windows login, database SalesDW (created with its tables on first start).
# MSSQL_CONNECTION_STRING="Driver={ODBC Driver 17 for SQL Server};Server=localhost;Database=SalesDW;Trusted_Connection=yes;"

# HOST: network interface the server listens on. Default 127.0.0.1 (this computer only).
# Set to 0.0.0.0 to allow other computers to connect (the app has no login).
# HOST="127.0.0.1"

# SEED_DEMO_DATA: set to true to load the demo data set when the database is empty.
# SEED_DEMO_DATA="false"
